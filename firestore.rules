// Regras do Firestore: clientes só criam pedidos válidos; ler, alterar status e ver endereços é só da equipe (coleção staff)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Equipe: existe um documento staff/{uid} criado pelo dono no console
    function isStaff() {
      return request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    match /orders/{orderId} {
      allow read, delete: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['order_code', 'type', 'table_number', 'address', 'subtotal', 'items', 'status', 'created_at'])
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['mesa', 'delivery']
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal > 0 && request.resource.data.subtotal < 5000
        && request.resource.data.items is map && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.created_at == request.time
        && request.resource.data.order_code is string && request.resource.data.order_code.size() <= 20
        && (request.resource.data.type == 'mesa'
              ? request.resource.data.table_number is string && request.resource.data.table_number.size() <= 3
              : request.resource.data.address is string && request.resource.data.address.size() >= 10 && request.resource.data.address.size() <= 200);
      // A equipe só muda o status
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'preparing', 'completed', 'cancelled'];
    }

    // Contador do código do pedido: qualquer um lê e só pode somar 1
    match /counters/orders_counter {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['current_seq']) && request.resource.data.current_seq == 1;
      allow update: if request.resource.data.keys().hasOnly(['current_seq']) && request.resource.data.current_seq == resource.data.current_seq + 1;
    }

    // Cada membro da equipe só lê o próprio registro; ninguém escreve pelo app
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
